# 复制为 .env 后修改。不要把 .env 提交到 Git。

# 镜像（默认拉 GHCR；本地构建可改成 family-meal-api:local）
API_IMAGE=ghcr.io/zzwen6/family-meal-api:latest
# 宿主机端口（opds-library 已占用 8080，这里默认 8090）
HTTP_PORT=8090
APP_TIMEZONE=Asia/Shanghai

# 已有的 MySQL（本 Compose 不再启动数据库）
# 库若跑在 NAS 宿主机上，用 host.docker.internal；若在其他容器里，填容器名或 IP，必要时加入同一 Docker 网络（见 docker-compose.yml 注释）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=family_meal
MYSQL_USER=family_meal
MYSQL_PASSWORD=change-me-mysql
MYSQL_USE_SSL=false
# 请先在已有 MySQL 上建好空库和账号，例如：
#   CREATE DATABASE family_meal DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'family_meal'@'%' IDENTIFIED BY '你的密码';
#   GRANT ALL ON family_meal.* TO 'family_meal'@'%';
# 表结构由应用启动时 Flyway 自动创建。

# 已有的 Redis（本 Compose 不再启动 Redis）
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 签名密钥，至少 32 字节。可用：openssl rand -base64 48
JWT_SECRET=please-generate-a-random-secret-of-at-least-32-bytes
JWT_TTL_HOURS=720

# 首次启动自动创建的管理员和默认家庭（已存在则忽略）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
ADMIN_FAMILY_NAME=我的家

# 微信小程序（个人主体即可；在 mp.weixin.qq.com → 开发管理 → 开发设置 中获取）
WECHAT_APPID=
WECHAT_SECRET=
# 未配置 AppID 时允许 wx-login 使用假 openid，仅限开发调试；生产保持 false
WECHAT_MOCK_ENABLED=false
# 开饭提醒订阅消息模板 ID（可选，推送逻辑尚为 TODO）
WECHAT_DINNER_READY_TEMPLATE_ID=

# H5 前端的来源（逗号分隔，支持通配，如 https://meal.example.com,http://localhost:5173）
CORS_ALLOWED_ORIGINS=http://localhost:5173

JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
